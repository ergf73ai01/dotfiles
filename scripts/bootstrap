#!/bin/bash
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_DIR="$HOME/.dotfiles-backup"

mkdir -p "$BACKUP_DIR"
mkdir -p "$HOME/.config"
mkdir -p "$HOME/Scripts"

backup_path() {
    local target="$1"
    local rel="${target#$HOME/}"
    local backup="$BACKUP_DIR/$rel"

    mkdir -p "$(dirname "$backup")"

    if [ -e "$backup" ] || [ -L "$backup" ]; then
        backup="${backup}.$(date +%Y%m%d-%H%M%S)"
    fi

    mv "$target" "$backup"
    printf 'Backup:   %s -> %s\n' "$target" "$backup"
}

ensure_link() {
    local source="$1"
    local target="$2"

    mkdir -p "$(dirname "$target")"

    if [ -L "$target" ]; then
        if [ "$(readlink "$target")" = "$source" ]; then
            printf 'OK:       %s -> %s\n' "$target" "$source"
            return
        fi

        backup_path "$target"
    elif [ -e "$target" ]; then
        backup_path "$target"
    fi

    ln -s "$source" "$target"
    printf 'Linked:   %s -> %s\n' "$target" "$source"
}

ensure_template() {
    local source="$1"
    local target="$2"

    mkdir -p "$(dirname "$target")"

    if [ -L "$target" ]; then
        backup_path "$target"
    elif [ -f "$target" ]; then
        if cmp -s "$source" "$target"; then
            printf 'OK:       %s\n' "$target"
            return
        fi

        backup_path "$target"
    elif [ -e "$target" ]; then
        backup_path "$target"
    fi

    cp "$source" "$target"
    printf 'Generated: %s <- %s\n' "$target" "$source"
}

echo "== dotfiles bootstrap =="
echo "Repository: $DOTFILES"
echo "Home:       $HOME"
echo

# Static configuration
ensure_link \
    "$DOTFILES/config/nvim" \
    "$HOME/.config/nvim"

ensure_link \
    "$DOTFILES/config/waybar/config" \
    "$HOME/.config/waybar/config"

# Scripts tracked by Git
for script in archbang-menu powermenu screenshot themebang bootstrap; do
    ensure_link \
        "$DOTFILES/scripts/$script" \
        "$HOME/Scripts/$script"
done

# Runtime files generated/managed by themebang
ensure_template \
    "$DOTFILES/templates/mango/config.conf" \
    "$HOME/.config/mango/config.conf"

ensure_template \
    "$DOTFILES/templates/waybar/style.css" \
    "$HOME/.config/waybar/style.css"

ensure_template \
    "$DOTFILES/templates/rofi/theme.rasi" \
    "$HOME/.config/rofi/theme.rasi"

ensure_template \
    "$DOTFILES/templates/rofi/wallpaper.rasi" \
    "$HOME/.config/rofi/wallpaper.rasi"

ensure_template \
    "$DOTFILES/templates/mako/config" \
    "$HOME/.config/mako/config"

echo
echo "Bootstrap completed."
echo "Backups: $BACKUP_DIR"
