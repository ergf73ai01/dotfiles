#!/bin/bash
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_DIR="$HOME/.dotfiles-backup"
PACKAGE_FILE="$DOTFILES/packages.txt"
AUR_PACKAGE_FILE="$DOTFILES/aur-packages.txt"

backup_path() {
    local target="$1"
    local rel="${target#$HOME/}"
    local backup="$BACKUP_DIR/$rel"

    mkdir -p "$(dirname "$backup")"

    if [ -e "$backup" ] || [ -L "$backup" ]; then
        backup="${backup}.$(date +%Y%m%d-%H%M%S)"
    fi

    mv "$target" "$backup"
    printf 'Backup:   %s -> %s\n' "$target" "$backup"
}

ensure_link() {
    local source="$1"
    local target="$2"

    mkdir -p "$(dirname "$target")"

    if [ -L "$target" ]; then
        if [ "$(readlink "$target")" = "$source" ]; then
            printf 'OK:       %s -> %s\n' "$target" "$source"
            return
        fi

        backup_path "$target"
    elif [ -e "$target" ]; then
        backup_path "$target"
    fi

    ln -s "$source" "$target"
    printf 'Linked:   %s -> %s\n' "$target" "$source"
}

ensure_template() {
    local source="$1"
    local target="$2"

    mkdir -p "$(dirname "$target")"

    if [ -L "$target" ]; then
        backup_path "$target"
        cp "$source" "$target"
        printf 'Generated: %s <- %s\n' "$target" "$source"
        return
    fi

    if [ -e "$target" ]; then
        printf 'OK:       %s\n' "$target"
        return
    fi

    cp "$source" "$target"
    printf 'Generated: %s <- %s\n' "$target" "$source"
}

install_official_packages() {
    [ -f "$PACKAGE_FILE" ] || {
        echo "ERROR: falta $PACKAGE_FILE" >&2
        exit 1
    }

    mapfile -t packages < <(
        grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$PACKAGE_FILE"
    )

    if [ "${#packages[@]}" -eq 0 ]; then
        echo "No hay paquetes oficiales para instalar."
        return
    fi

    echo "== Official packages =="
    printf '  %s\n' "${packages[@]}"
    echo

    echo "Checking package availability..."
    pacman -Sp --needed "${packages[@]}" >/dev/null

    echo "Installing official packages..."
    sudo pacman -S --needed "${packages[@]}"
    echo
}

show_aur_packages() {
    [ -f "$AUR_PACKAGE_FILE" ] || return

    mapfile -t aur_packages < <(
        grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$AUR_PACKAGE_FILE"
    )

    [ "${#aur_packages[@]}" -gt 0 ] || return

    echo "== AUR packages =="
    echo "Not installed automatically:"
    printf '  %s\n' "${aur_packages[@]}"
    echo
}

echo "== dotfiles bootstrap =="
echo "Repository: $DOTFILES"
echo "Home:       $HOME"
echo

install_official_packages
show_aur_packages

mkdir -p "$BACKUP_DIR"
mkdir -p "$HOME/.config"
mkdir -p "$HOME/Scripts"

# Static configuration
ensure_link \
    "$DOTFILES/config/nvim" \
    "$HOME/.config/nvim"

ensure_link \
    "$DOTFILES/config/waybar/config" \
    "$HOME/.config/waybar/config"

ensure_link \
    "$DOTFILES/config/rofi/config.rasi" \
    "$HOME/.config/rofi/config.rasi"

ensure_link \
    "$DOTFILES/config/systemd/user/themebang-rotate.service" \
    "$HOME/.config/systemd/user/themebang-rotate.service"

ensure_link \
    "$DOTFILES/config/systemd/user/themebang-rotate.timer" \
    "$HOME/.config/systemd/user/themebang-rotate.timer"

ensure_template \
    "$DOTFILES/config/themebang/themebang.conf" \
    "$HOME/.config/themebang.conf"

# Scripts tracked by Git
for script in archbang-menu powermenu screenshot themebang bootstrap; do
    ensure_link \
        "$DOTFILES/scripts/$script" \
        "$HOME/Scripts/$script"
done

# Runtime files generated/managed by themebang
ensure_template \
    "$DOTFILES/templates/mango/config.conf" \
    "$HOME/.config/mango/config.conf"

ensure_template \
    "$DOTFILES/templates/waybar/style.css" \
    "$HOME/.config/waybar/style.css"

ensure_template \
    "$DOTFILES/templates/rofi/theme.rasi" \
    "$HOME/.config/rofi/theme.rasi"

ensure_template \
    "$DOTFILES/templates/rofi/wallpaper.rasi" \
    "$HOME/.config/rofi/wallpaper.rasi"

ensure_template \
    "$DOTFILES/templates/mako/config" \
    "$HOME/.config/mako/config"

echo
echo "Bootstrap completed."
echo "Backups: $BACKUP_DIR"
