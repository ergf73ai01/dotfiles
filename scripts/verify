#!/bin/bash
set -u

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ERRORS=0

ok() {
    printf 'OK: %s\n' "$1"
}

fail() {
    printf 'ERROR: %s\n' "$1"
    ERRORS=$((ERRORS + 1))
}

check_link() {
    local target="$1"
    local expected="$2"

    if [ -L "$target" ] && [ "$(readlink "$target")" = "$expected" ]; then
        ok "$target"
    else
        fail "$target"
    fi
}

check_file() {
    local path="$1"

    if [ -f "$path" ]; then
        ok "$path"
    else
        fail "$path"
    fi
}

echo "========================================"
echo "        ARCHBANG DOTFILES VERIFY"
echo "========================================"
echo "Repository: $DOTFILES"
echo

echo "===== GIT ====="
if git -C "$DOTFILES" diff --quiet && git -C "$DOTFILES" diff --cached --quiet; then
    ok "working tree clean"
else
    fail "working tree has changes"
fi

echo
echo "===== STATIC SYMLINKS ====="

check_link "$HOME/.bashrc" "$DOTFILES/config/bash/bashrc"
check_link "$HOME/.bash_profile" "$DOTFILES/config/bash/bash_profile"
check_link "$HOME/.config/foot/foot.ini" "$DOTFILES/config/foot/foot.ini"
check_link "$HOME/.config/gtk-3.0/gtk.css" "$DOTFILES/config/gtk-3.0/gtk.css"
check_link "$HOME/.config/gtk-3.0/settings.ini" "$DOTFILES/config/gtk-3.0/settings.ini"
check_link "$HOME/.config/networkmanager-dmenu/config.ini" "$DOTFILES/config/networkmanager-dmenu/config.ini"
check_link "$HOME/.config/nvim" "$DOTFILES/config/nvim"
check_link "$HOME/.config/waybar/config" "$DOTFILES/config/waybar/config"
check_link "$HOME/.config/rofi/config.rasi" "$DOTFILES/config/rofi/config.rasi"

echo
echo "===== RUNTIME ====="

check_file "$HOME/.config/themebang.conf"
check_file "$HOME/.config/mango/config.conf"
check_file "$HOME/.config/waybar/style.css"
check_file "$HOME/.config/rofi/theme.rasi"
check_file "$HOME/.config/rofi/wallpaper.rasi"
check_file "$HOME/.config/mako/config"
check_file "/etc/greetd/gtkgreet.css"

echo
echo "===== PROGRAMS ====="

for cmd in mango waybar rofi makoctl foot wpctl grim slurp python3; do
    if command -v "$cmd" >/dev/null 2>&1; then
        ok "$cmd"
    else
        fail "$cmd"
    fi
done

echo
echo "===== SCRIPTS ====="

for script in archbang-menu powermenu screenshot themebang bootstrap system-setup; do
    path="$DOTFILES/scripts/$script"

    if [ -x "$path" ]; then
        ok "$script"
    else
        fail "$script"
    fi
done

echo
echo "===== SYNTAX ====="

if bash -n "$DOTFILES/scripts/bootstrap"; then
    ok "bootstrap syntax"
else
    fail "bootstrap syntax"
fi

if bash -n "$DOTFILES/scripts/system-setup"; then
    ok "system-setup syntax"
else
    fail "system-setup syntax"
fi

if python3 -m py_compile "$DOTFILES/scripts/themebang"; then
    ok "themebang Python syntax"
else
    fail "themebang Python syntax"
fi

echo
echo "===== MANGO ====="

if mango -p >/dev/null 2>&1; then
    ok "mango config"
else
    fail "mango config"
fi

echo
echo "===== PROCESSES ====="

for proc in mango waybar mako; do
    if pgrep -x "$proc" >/dev/null 2>&1; then
        ok "$proc process"
    else
        fail "$proc process"
    fi
done

echo
echo "===== SERVICES ====="

for service in greetd NetworkManager; do
    if systemctl is-active --quiet "$service"; then
        ok "$service"
    else
        fail "$service"
    fi
done

for service in pipewire pipewire-pulse wireplumber; do
    if systemctl --user is-active --quiet "$service"; then
        ok "$service"
    else
        fail "$service"
    fi
done

echo
echo "===== ZRAM ====="

if swapon --show=NAME,TYPE,SIZE,USED,PRIO | grep -q '^/dev/zram0 '; then
    ok "/dev/zram0 active"
else
    fail "/dev/zram0 active"
fi

if grep -q '^zram-size = ram$' "$DOTFILES/system/zram/zram-generator.conf"; then
    ok "zram-size = ram"
else
    fail "zram-size = ram"
fi

echo
echo "===== OFFICIAL PACKAGES ====="

mapfile -t packages < <(
    grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$DOTFILES/packages.txt"
)

for package in "${packages[@]}"; do
    if pacman -Q "$package" >/dev/null 2>&1; then
        ok "$package"
    else
        fail "$package"
    fi
done

echo
echo "========================================"

if [ "$ERRORS" -eq 0 ]; then
    echo "VERIFY: OK"
    echo "========================================"
    exit 0
else
    echo "VERIFY: FAIL ($ERRORS)"
    echo "========================================"
    exit 1
fi
