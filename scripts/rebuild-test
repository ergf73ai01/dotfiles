#!/bin/bash
set -euo pipefail

SOURCE_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEST_ROOT="$(mktemp -d /tmp/dotfiles-rebuild-test.XXXXXX)"
TEST_REPO="$TEST_ROOT/repo"
TEST_HOME="$TEST_ROOT/home"
TEST_SYSTEM="$TEST_ROOT/system"
TEST_BIN="$TEST_ROOT/bin"

cleanup() {
    rm -rf "$TEST_ROOT"
}
trap cleanup EXIT

fail() {
    echo "ERROR: $1" >&2
    exit 1
}

ok() {
    echo "OK: $1"
}

echo "========================================"
echo "       DOTFILES REBUILD TEST"
echo "========================================"
echo "Source: $SOURCE_REPO"
echo "Test:   $TEST_ROOT"
echo

echo "===== 1. CLON DE PRUEBA ====="

mkdir -p "$TEST_HOME" "$TEST_SYSTEM" "$TEST_BIN"

cp -a "$SOURCE_REPO" "$TEST_REPO"

ok "repo de prueba creado"

echo
echo "===== 2. MOCK PRIVILEGED COMMANDS ====="

cat > "$TEST_BIN/sudo" <<'EOF'
#!/bin/bash
exec "$@"
EOF

chmod +x "$TEST_BIN/sudo"

cat > "$TEST_BIN/pacman" <<'EOF'
#!/bin/bash
echo "[MOCK PACMAN] $*"
exit 0
EOF

chmod +x "$TEST_BIN/pacman"

ok "sudo y pacman aislados"

echo
echo "===== 3. PRIMER BOOTSTRAP ====="

HOME="$TEST_HOME" \
PATH="$TEST_BIN:$PATH" \
    "$TEST_REPO/scripts/bootstrap"

echo
echo "===== 4. COMPROBAR SYMLINKS ====="

check_link() {
    local target="$1"
    local expected="$2"

    [ -L "$target" ] || fail "no es symlink: $target"
    [ "$(readlink "$target")" = "$expected" ] \
        || fail "symlink incorrecto: $target"

    ok "$target"
}

check_link \
    "$TEST_HOME/.bashrc" \
    "$TEST_REPO/config/bash/bashrc"

check_link \
    "$TEST_HOME/.bash_profile" \
    "$TEST_REPO/config/bash/bash_profile"

check_link \
    "$TEST_HOME/.config/foot/foot.ini" \
    "$TEST_REPO/config/foot/foot.ini"

check_link \
    "$TEST_HOME/.config/gtk-3.0/gtk.css" \
    "$TEST_REPO/config/gtk-3.0/gtk.css"

check_link \
    "$TEST_HOME/.config/gtk-3.0/settings.ini" \
    "$TEST_REPO/config/gtk-3.0/settings.ini"

check_link \
    "$TEST_HOME/.config/networkmanager-dmenu/config.ini" \
    "$TEST_REPO/config/networkmanager-dmenu/config.ini"

check_link \
    "$TEST_HOME/.config/nvim" \
    "$TEST_REPO/config/nvim"

check_link \
    "$TEST_HOME/.config/waybar/config" \
    "$TEST_REPO/config/waybar/config"

check_link \
    "$TEST_HOME/.config/rofi/config.rasi" \
    "$TEST_REPO/config/rofi/config.rasi"

echo
echo "===== 5. COMPROBAR RUNTIME ====="

for file in \
    "$TEST_HOME/.config/themebang.conf" \
    "$TEST_HOME/.config/mango/config.conf" \
    "$TEST_HOME/.config/waybar/style.css" \
    "$TEST_HOME/.config/rofi/theme.rasi" \
    "$TEST_HOME/.config/rofi/wallpaper.rasi" \
    "$TEST_HOME/.config/mako/config"
do
    [ -f "$file" ] || fail "runtime faltante: $file"
    ok "$file"
done

echo
echo "===== 6. SYSTEM-SETUP ====="

SYSTEM_ROOT="$TEST_SYSTEM" \
PATH="$TEST_BIN:$PATH" \
    "$TEST_REPO/scripts/system-setup"

for file in \
    "$TEST_SYSTEM/etc/greetd/config.toml" \
    "$TEST_SYSTEM/etc/greetd/environments" \
    "$TEST_SYSTEM/etc/greetd/gtkgreet.css" \
    "$TEST_SYSTEM/etc/environment" \
    "$TEST_SYSTEM/etc/systemd/zram-generator.conf"
do
    [ -f "$file" ] || fail "system file faltante: $file"
    ok "$file"
done

echo
echo "===== 7. PRESERVAR RUNTIME ====="

printf '\n# REBUILD TEST RUNTIME\n' \
    >> "$TEST_HOME/.config/mango/config.conf"

printf '\n# REBUILD TEST THEMEBANG\n' \
    >> "$TEST_HOME/.config/themebang.conf"

ok "runtime modificado"

echo
echo "===== 8. SEGUNDO BOOTSTRAP ====="

HOME="$TEST_HOME" \
PATH="$TEST_BIN:$PATH" \
    "$TEST_REPO/scripts/bootstrap" >/tmp/dotfiles-rebuild-second.log

if grep -q '^Backup:' /tmp/dotfiles-rebuild-second.log; then
    fail "segundo bootstrap creó backups inesperados"
fi

grep -q 'REBUILD TEST RUNTIME' \
    "$TEST_HOME/.config/mango/config.conf" \
    || fail "Mango runtime no fue preservado"

grep -q 'REBUILD TEST THEMEBANG' \
    "$TEST_HOME/.config/themebang.conf" \
    || fail "ThemeBang runtime no fue preservado"

ok "runtime preservado"
ok "segundo bootstrap idempotente"

echo
echo "===== 9. SYSTEM-SETUP REPETIDO ====="

SYSTEM_ROOT="$TEST_SYSTEM" \
    "$TEST_REPO/scripts/system-setup" >/tmp/dotfiles-rebuild-system-second.log

if grep -q '^Installed:' /tmp/dotfiles-rebuild-system-second.log; then
    fail "system-setup volvió a instalar archivos idénticos"
fi

ok "system-setup idempotente"

echo
echo "===== 10. SINTAXIS ====="

bash -n "$TEST_REPO/scripts/bootstrap"
ok "bootstrap syntax"

bash -n "$TEST_REPO/scripts/system-setup"
ok "system-setup syntax"

python3 -m py_compile "$TEST_REPO/scripts/themebang"
ok "themebang Python syntax"

echo
echo "===== 11. PAQUETES ====="

grep -qx 'cage' "$TEST_REPO/packages.txt" \
    || fail "cage falta en packages.txt"

grep -qx 'zram-generator' "$TEST_REPO/packages.txt" \
    || fail "zram-generator falta en packages.txt"

ok "paquetes críticos"

echo
echo "===== 12. ESTRUCTURA ====="

for path in \
    "$TEST_REPO/config" \
    "$TEST_REPO/templates" \
    "$TEST_REPO/scripts" \
    "$TEST_REPO/system" \
    "$TEST_REPO/packages.txt" \
    "$TEST_REPO/aur-packages.txt" \
    "$TEST_REPO/README.md"
do
    [ -e "$path" ] || fail "falta: $path"
done

ok "estructura"

echo
echo "===== 13. RESULTADO ====="
echo "REBUILD TEST: OK"
echo "========================================"
