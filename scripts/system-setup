#!/bin/bash
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SYSTEM_ROOT="${SYSTEM_ROOT:-}"
BACKUP_DIR="${SYSTEM_ROOT}/var/backups/dotfiles"
GREETD_DIR="${SYSTEM_ROOT}/etc/greetd"

backup_path() {
    local target="$1"
    local rel

    if [ -n "$SYSTEM_ROOT" ]; then
        rel="${target#"$SYSTEM_ROOT"}"
        rel="${rel#/}"
    else
        rel="${target#/}"
    fi

    local backup="$BACKUP_DIR/$rel"

    sudo mkdir -p "$(dirname "$backup")"

    if [ -e "$backup" ] || [ -L "$backup" ]; then
        backup="${backup}.$(date +%Y%m%d-%H%M%S)"
    fi

    sudo mv "$target" "$backup"
    printf 'Backup:   %s -> %s\n' "$target" "$backup"
}

install_system_file() {
    local source="$1"
    local target="$2"

    if [ ! -f "$source" ]; then
        echo "ERROR: falta $source" >&2
        exit 1
    fi

    if [ -f "$target" ]; then
        if cmp -s "$source" "$target"; then
            printf 'OK:       %s\n' "$target"
            return
        fi

        backup_path "$target"
    elif [ -e "$target" ] || [ -L "$target" ]; then
        backup_path "$target"
    fi

    sudo install -D -m 0644 "$source" "$target"
    printf 'Installed: %s <- %s\n' "$target" "$source"
}

ensure_system_template() {
    local source="$1"
    local target="$2"

    if [ ! -f "$source" ]; then
        echo "ERROR: falta $source" >&2
        exit 1
    fi

    sudo mkdir -p "$(dirname "$target")"

    if [ -L "$target" ]; then
        backup_path "$target"
        sudo install -D -m 0644 "$source" "$target"
        printf 'Generated: %s <- %s\n' "$target" "$source"
        return
    fi

    if [ -f "$target" ]; then
        printf 'OK:       %s\n' "$target"
        return
    fi

    if [ -e "$target" ]; then
        backup_path "$target"
    fi

    sudo install -D -m 0644 "$source" "$target"
    printf 'Generated: %s <- %s\n' "$target" "$source"
}

echo "== dotfiles system setup =="
echo "Repository: $DOTFILES"
echo "System root: $SYSTEM_ROOT"
echo

echo "== greetd =="
install_system_file \
    "$DOTFILES/system/greetd/config.toml" \
    "$GREETD_DIR/config.toml"

install_system_file \
    "$DOTFILES/system/greetd/environments" \
    "$GREETD_DIR/environments"

ensure_system_template \
    "$DOTFILES/templates/greetd/gtkgreet.css" \
    "$GREETD_DIR/gtkgreet.css"

echo
echo "== environment =="
install_system_file \
    "$DOTFILES/system/environment" \
    "${SYSTEM_ROOT}/etc/environment"

echo
echo "== zram =="
install_system_file \
    "$DOTFILES/system/zram/zram-generator.conf" \
    "${SYSTEM_ROOT}/etc/systemd/zram-generator.conf"

echo
echo "System setup completed."
echo "Backups: $BACKUP_DIR"
echo
echo "Note: no services were enabled, restarted, or reloaded."
